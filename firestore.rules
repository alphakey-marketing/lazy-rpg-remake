rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players can only drop feedback in. Nobody can read/edit from client.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasAll(['text', 'mood', 'pid', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.mood in ['love', 'ok', 'bored', 'bug']
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }
    // Cloud save: owner only. Guest (anonymous) + Google both have uid.
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["data", "meta", "at"])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000
        && request.resource.data.meta is map
        && request.resource.data.at == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
